rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function expectedNameKey() {
      return get(/databases/$(database)/documents/settings/main).data.expectedName.lower();
    }

    function validBookingFields() {
      return request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() < 100
        && request.resource.data.guestName.lower() == expectedNameKey()
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() < 64
        && request.resource.data.activity is string
        && request.resource.data.activity.size() > 0
        && request.resource.data.activity.size() < 64
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.locale in ['nl', 'en'];
    }

    match /settings/main {
      allow read: if true;
      allow write: if false;
    }

    // Doc id must be the invited name (lowercased). List is denied —
    // without the correct name you cannot discover or read a booking.
    match /booking/{nameKey} {
      allow get: if nameKey == expectedNameKey();
      allow list: if false;
      allow create, update: if nameKey == expectedNameKey()
        && nameKey == request.resource.data.guestName.lower()
        && validBookingFields();
      allow delete: if false;
    }
  }
}
